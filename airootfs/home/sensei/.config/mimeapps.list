# Windows처럼 더블클릭했을 때 열리는 기본 프로그램
[Default Applications]
x-scheme-handler/claude-cli=claude-code-url-handler.desktop
inode/directory=thunar.desktop
text/markdown=shittim-view.desktop
text/x-markdown=shittim-view.desktop
application/pdf=org.gnome.Evince.desktop
text/plain=org.xfce.mousepad.desktop
text/x-log=org.xfce.mousepad.desktop
text/csv=org.xfce.mousepad.desktop
application/json=org.xfce.mousepad.desktop
application/xml=org.xfce.mousepad.desktop
text/x-shellscript=org.xfce.mousepad.desktop
text/x-python=org.xfce.mousepad.desktop
application/x-shellscript=org.xfce.mousepad.desktop
text/x-csrc=org.xfce.mousepad.desktop
text/x-c++src=org.xfce.mousepad.desktop
text/x-lua=org.xfce.mousepad.desktop
text/x-qml=org.xfce.mousepad.desktop
image/png=imv.desktop
image/jpeg=imv.desktop
image/gif=imv.desktop
image/webp=imv.desktop
image/bmp=imv.desktop
image/svg+xml=imv.desktop
image/tiff=imv.desktop
image/avif=imv.desktop
video/mp4=mpv.desktop
video/x-matroska=mpv.desktop
video/webm=mpv.desktop
video/quicktime=mpv.desktop
video/x-msvideo=mpv.desktop
audio/mpeg=mpv.desktop
audio/flac=mpv.desktop
audio/x-wav=mpv.desktop
audio/ogg=mpv.desktop
audio/mp4=mpv.desktop
audio/aac=mpv.desktop
text/html=chromium.desktop
x-scheme-handler/http=chromium.desktop
x-scheme-handler/https=chromium.desktop
application/zip=shittim-extract.desktop
application/x-7z-compressed=shittim-extract.desktop
application/vnd.rar=shittim-extract.desktop
application/x-rar=shittim-extract.desktop
application/x-tar=shittim-extract.desktop
application/x-compressed-tar=shittim-extract.desktop
application/x-bzip-compressed-tar=shittim-extract.desktop
application/x-bzip2-compressed-tar=shittim-extract.desktop
application/x-xz-compressed-tar=shittim-extract.desktop
application/x-zstd-compressed-tar=shittim-extract.desktop
application/gzip=shittim-extract.desktop
application/x-bzip2=shittim-extract.desktop
application/x-xz=shittim-extract.desktop
application/zstd=shittim-extract.desktop
application/x-alz=shittim-extract.desktop
application/x-zip-compressed=shittim-extract.desktop
