#!/usr/bin/env python3
# 한/영 키를 누를 때마다 Hyprland가 부른다 (hyprland.lua 의 Hangul 단축키).
# XWayland 창(카카오톡 = Wine)이 활성인데 X 입력 포커스가 없으면 입력기(fcitx5 XIM)가 그 창에 안 붙어 영어만 쳐진다.
# 그때 X 포커스를 활성 창에 다시 준다. 고친 때의 상태는 ~/.cache/shittim-ime.log 에 남긴다 (원인 추적용).
#   --test-break : 고장 상태를 일부러 만든다 (X 포커스를 없앤다)
import ctypes, json, os, subprocess, sys, time

X = ctypes.CDLL("libX11.so.6")
X.XOpenDisplay.restype = ctypes.c_void_p
X.XInternAtom.restype = ctypes.c_ulong
X.XInternAtom.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_int]
X.XDefaultRootWindow.restype = ctypes.c_ulong
X.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
X.XSetInputFocus.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_int, ctypes.c_ulong]
X.XGetInputFocus.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_ulong), ctypes.POINTER(ctypes.c_int)]
X.XGetWindowProperty.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_long, ctypes.c_long, ctypes.c_int,
                                 ctypes.c_ulong, ctypes.POINTER(ctypes.c_ulong), ctypes.POINTER(ctypes.c_int),
                                 ctypes.POINTER(ctypes.c_ulong), ctypes.POINTER(ctypes.c_ulong),
                                 ctypes.POINTER(ctypes.POINTER(ctypes.c_ulong))]
X.XSync.argtypes = [ctypes.c_void_p, ctypes.c_int]

d = X.XOpenDisplay(None)
if not d: sys.exit(0)

def xfocus():
    w, r = ctypes.c_ulong(), ctypes.c_int()
    X.XGetInputFocus(d, ctypes.byref(w), ctypes.byref(r))
    return w.value

def active_xwin():   # 루트 창의 _NET_ACTIVE_WINDOW
    t, f, n, left, data = ctypes.c_ulong(), ctypes.c_int(), ctypes.c_ulong(), ctypes.c_ulong(), ctypes.POINTER(ctypes.c_ulong)()
    X.XGetWindowProperty(d, X.XDefaultRootWindow(d), X.XInternAtom(d, b"_NET_ACTIVE_WINDOW", 0), 0, 1, 0, 0,
                         ctypes.byref(t), ctypes.byref(f), ctypes.byref(n), ctypes.byref(left), ctypes.byref(data))
    return data[0] if n.value else 0

def xim_focused():   # fcitx5 가 보기에 XIM 입력 칸 하나가 포커스를 갖고 있나
    out = subprocess.run(["dbus-send", "--print-reply", "--dest=org.fcitx.Fcitx5", "/controller",
                          "org.fcitx.Fcitx.Controller1.DebugInfo"], capture_output=True, text=True).stdout
    return any("frontend:xim" in l and "focus:1" in l for l in out.splitlines())

AUTO = "--auto" in sys.argv   # hyprland.lua 의 window.active 가 부른다 (한/영 키 없이)
if "--test-break" in sys.argv:
    X.XSetInputFocus(d, 0, 0, 0); X.XSync(d, 0); sys.exit(0)

win = json.loads(subprocess.run(["hyprctl", "activewindow", "-j"], capture_output=True, text=True).stdout or "{}")
if not win.get("xwayland"): sys.exit(0)
fx, ax = xfocus(), active_xwin()
# 고장 = X 포커스가 아예 없다(None 0 / PointerRoot 1). 카카오톡은 포커스가 있어도 입력기가 안 붙은 경우까지 본다.
broken = fx <= 1 or (win.get("class") == "kakaotalk.exe" and not xim_focused())
# 고장 2 = X 창이 활성인데 Wayland 입력기(wayland_v2)도 켜져 있다: 한글 조합이 그쪽으로 새서 한글만 사라진다.
# 포커스가 Wayland 창(kitty)을 아주 짧게 스쳐 X 창으로 오면 Hyprland 가 입력기를 켠 채로 둔다 (kitty 의 늦은 enable).
stale = any("frontend:wayland" in l and "focus:1" in l for l in subprocess.run(["dbus-send", "--print-reply",
        "--dest=org.fcitx.Fcitx5", "/controller", "org.fcitx.Fcitx.Controller1.DebugInfo"], capture_output=True, text=True).stdout.splitlines())
# 원인 추적용: 한/영을 누를 때마다 그 순간의 상태를 남긴다 (focus:1 인 입력 칸, 입력기 상태 1=영어 2=한글)
def log(what):
    ics = [l.split()[2] + "/" + l.split()[3] for l in subprocess.run(["dbus-send", "--print-reply", "--dest=org.fcitx.Fcitx5",
           "/controller", "org.fcitx.Fcitx.Controller1.DebugInfo"], capture_output=True, text=True).stdout.splitlines() if "focus:1" in l]
    st = subprocess.run(["fcitx5-remote"], capture_output=True, text=True).stdout.strip()
    os.makedirs(os.path.expanduser("~/.cache"), exist_ok=True)
    with open(os.path.expanduser("~/.cache/shittim-ime.log"), "a") as f:
        f.write("%s %s class=%s title=%s xfocus=%#x active=%#x 입력기=%s focus=%s\n" % (time.strftime("%F %T"), what, win.get("class"), win.get("title"), fx, ax, st, ics))
if stale:
    # 입력기를 켠 Wayland 창을 천천히 한 번 거쳐 돌아오면 꺼진다 (X 창을 거치는 것으로는 안 꺼짐).
    # shortcut: 같은 작업 공간의 Wayland 창만 거친다, 다른 작업 공간 창이 원인이면 그 창을 한 번 눌렀다 오면 된다
    focus = lambda addr: subprocess.run(["hyprctl", "dispatch", 'hl.dsp.focus({window="address:%s"})' % addr], capture_output=True)
    for c in json.loads(subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True).stdout or "[]"):
        if not c["xwayland"] and c["mapped"] and c["workspace"]["id"] == win["workspace"]["id"]:
            focus(c["address"]); time.sleep(0.2)
    focus(win["address"]); time.sleep(0.2)
    if AUTO: log("고침-wayland-자동"); sys.exit(0)
    subprocess.run(["fcitx5-remote", "-o"])   # 한글이 안 쳐져서 누른 것이므로 한글 상태로 둔다
    log("고침-wayland"); sys.exit(0)
if AUTO: sys.exit(0)   # 자동(창이 활성이 될 때)은 위의 고장 2만 고친다, 로그도 고쳤을 때만
if not broken or not ax: log("정상"); sys.exit(0)
X.XSetInputFocus(d, 0, 0, 0)      # 같은 창에 다시 주면 FocusIn 이 안 가므로 한 번 뗐다가 준다
X.XSetInputFocus(d, ax, 2, 0)     # 2 = RevertToParent
X.XSync(d, 0)
log("고침")
