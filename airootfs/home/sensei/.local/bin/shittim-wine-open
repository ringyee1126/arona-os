#!/usr/bin/env bash
# 카카오톡(Wine)에서 받은 파일을 눌렀을 때: Windows 프로그램 대신 이 OS의 기본 프로그램으로 연다.
# (연결이 없으면 Wine이 "이 형식의 파일을 열도록 구성된 Windows 프로그램이 없습니다" 경고를 띄운다.)
# shittim-wine-open --register : 지금 WINEPREFIX에 파일 형식 연결을 등록한다 (kakaotalk 스크립트가 부른다)
EXTS="md markdown txt log csv json xml pdf zip 7z rar tar gz tgz bz2 xz alz egg png jpg jpeg gif webp bmp svg heic mp4 mkv mov avi webm mp3 wav flac ogg m4a doc docx xls xlsx ppt pptx hwp hwpx odt ods odp html htm py sh c cpp h cs lua qml"
if [[ ${1:-} == --register ]]; then
  reg=$(mktemp --suffix=.reg)
  { printf 'REGEDIT4\n\n[HKEY_CLASSES_ROOT\\shittimfile\\shell\\open\\command]\n@="C:\\\\windows\\\\system32\\\\start.exe /unix %s \\"%%1\\""\n\n' "$(realpath "$0")"
    for e in $EXTS; do printf '[HKEY_CLASSES_ROOT\\.%s]\n@="shittimfile"\n\n' "$e"; done; } > "$reg"
  wine regedit "$reg" >/dev/null 2>&1; rc=$?; rm -f "$reg"; exit $rc
fi
p=$(winepath -u -- "$1" 2>/dev/null); [[ -e $p ]] || p=$1
exec gio open "$p"
