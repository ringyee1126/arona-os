#!/bin/sh
# 로그인 화면(greetd, greeter 사용자)이 쓸 파일을 sensei 의 셸 설정에서 복사한다. 루트로 실행
# (shittim-postinstall, 그리고 성격이 바뀔 때 shittim-splash-who).
# greeter 사용자는 /home/sensei 를 읽지 못한다(읽게 해서도 안 된다): QML 과 그림만 /usr/share/shittim-greeter 로 옮긴다.
# 목소리와 API 키(arona.json)는 옮기지 않는다. 성격(아로나/프라나)만 알려 준다.
Q=/home/sensei/.config/quickshell; D=/usr/share/shittim-greeter; H=/var/lib/shittim-greeter
[ -f $Q/greeter.qml ] || exit 0
mkdir -p $D $H/.config/shittim
rsync -a --delete --exclude=assets/voice --exclude=.omc --chown=root:root --chmod=D755,F644 $Q/ $D/ || exit 1
who=arona; grep -Eqs '"persona" *: *"plana"' /home/sensei/.config/shittim/arona.json && who=plana
printf '{"persona": "%s", "voice": false}\n' $who > $H/.config/shittim/arona.json
chown -R greeter:greeter $H 2>/dev/null || true     # greeter 사용자는 greetd 패키지가 만든다
