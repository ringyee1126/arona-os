#!/bin/sh
# Boot cutscene: wait until the splash has been on screen for 5.5 s, so it always plays to the end.
# Called by plymouth-quit.service.d/shittim.conf. Never waits more than 8 s and never fails (boot must go on).
s=$(systemctl show -p ActiveEnterTimestampMonotonic --value plymouth-start.service 2>/dev/null); s=${s:-0}
i=0
while [ "$i" -lt 80 ] && [ "$(awk '{print int($1 * 1000000)}' /proc/uptime)" -lt "$((s + 5500000))" ]; do
    sleep 0.1; i=$((i + 1))
done
exit 0
