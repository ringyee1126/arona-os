#!/bin/sh
# 부팅·종료 컷씬 색을 지금 캐릭터에 맞춘다 (아로나 = 파랑, 프라나 = 보라). 루트로 실행 (shittim-splash-who.service).
# 부팅 컷씬 그림은 initramfs 안에 있어서, 캐릭터가 바뀐 때에만 그림을 바꿔 넣고 initramfs를 다시 만든다 (약 10~20초).
trap '' TERM    # 다시 만드는 도중에 전원을 꺼도 끝까지 한다 (서비스의 KillMode=mixed 와 한 쌍)
T=/usr/share/plymouth/themes/shittim
who=arona; grep -Eqs '"persona" *: *"plana"' /home/sensei/.config/shittim/arona.json && who=plana
[ "$(cat $T/who 2>/dev/null)" = "$who" ] && exit 0
cp $T/$who/*.png $T/ && echo $who > $T/who && mkinitcpio -P
