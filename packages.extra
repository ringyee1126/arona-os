# 2026-11-19 노트북에서 추가한 패키지 (이유 한 줄씩)
steam                 # 블루 아카이브(업무 시작하기)
lib32-vulkan-radeon   # Steam/Proton 32비트 Vulkan (Radeon 840M)
gamemode              # 게임 실행 중 CPU 성능 모드
lib32-gamemode        # 위와 같음, 32비트 게임용
fuzzel                # Super+V 클립보드 기록 목록
udiskie               # USB 메모리 자동 마운트 (Windows처럼 꽂으면 바로)
tumbler               # 파일 관리자의 사진 미리보기(썸네일)
ffmpegthumbnailer     # 동영상 썸네일
gnome-calculator      # 계산기
mission-center        # 작업 관리자
polkit-gnome          # 관리자 권한 비밀번호 창
cups                  # 인쇄
system-config-printer # 프린터 추가 화면
linux-headers         # 내장 스피커 드라이버 모듈 빌드 (shittim-speaker-rebuild)
pahole                # 위와 같음 (커널 모듈 빌드 도구)
# 2026-11-20 친구 노트북(GIGABYTE 게이밍: Intel/AMD 내장 + NVIDIA 외장)용. 해당 장치가 없는 기종에서는 쓰이지 않는다
nvidia-open           # NVIDIA 드라이버 (GTX 16xx / RTX 20 이후). 없으면 nouveau라 게임·절전이 불안정
nvidia-utils          # 위 드라이버의 OpenGL/Vulkan
lib32-nvidia-utils    # Steam/Proton 32비트
nvidia-prime          # prime-run: 외장 그래픽으로 실행 (Steam 실행 옵션: prime-run %command%)
vulkan-intel          # Intel 내장 그래픽 Vulkan
lib32-vulkan-intel    # 위와 같음, 32비트
intel-media-driver    # Intel 내장 그래픽 동영상 가속
jre-openjdk-headless  # hwp/hwpx 열기: LibreOffice 확장 H2Orestart 가 Java 를 쓴다 (tools/setup-hwp.sh)
